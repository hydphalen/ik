        "call": "resolveToken",
        "args": { "token": "@Color_Text_L2" }
      },
      "selectedTextColor": {
        "call": "resolveToken",
        "args": { "token": "@Color_Text_Brand" }
      },
      "styles": {
          "background-color": {
            "call": "resolveToken",
            "args": { "token": "@Color_BG_L2" }
