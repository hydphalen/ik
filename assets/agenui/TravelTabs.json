    },
    {
      "id": "tab_content_0",
      "component": "Row",
      "justify": "spaceBetween",
      "align": "start",
      "styles": {
        "padding": "16px 16px 16px 16px"
      },
      "children": [
        "icon_container_0",
        "info_col_0",
        "nav_button_0"
      ]
    },
    {
