      "children": ["title_0", "details_0"]
    },
    {
      "id": "title_0",
      "component": "Text",
      "text": "@placeholder(title0)",
      "variant": "h3",
       "styles": {
        "color": {
          "call":"resolveToken",
          "args": { "token": "@Color_Text_L1" }
        }
      }
    },
    {
      "id": "details_0",
      "component": "Text",
      "text": "@placeholder(subTitle0)",
      "variant": "body",
      "styles": {
        "color": {
          "call":"resolveToken",
          "args": { "token": "@Color_Text_L2" }
        }
      }
    },
    {
      "id": "nav_button_0",
      "component": "Button",
      "child": "button_text_0",
      "styles": {
        "background-color": "rgba(34, 115, 247, 0.14)",
        "border-color": "rgba(34, 115, 247, 0.14)",
        "border-radius": "8px",
        "padding": "12px 24px"
      },
      "action": {
        "functionCall": {
